{
  "name": "number-duel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && node -e \"const { execSync } = require('child_process'); if (process.env.DATABASE_URL) { execSync('prisma migrate deploy', { stdio: 'inherit' }); }\" && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@supabase/supabase-js": "^2.56.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.0.1",
    "next": "15.5.4",
    "prisma": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
